# ---------------------------------------------------------------------------
# Required: the shared secret the iPhone Shortcut sends as its bearer token.
# Server-side only — never prefix it with NEXT_PUBLIC_ and never paste it into
# client code. Generate one with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
LOCATION_UPDATE_TOKEN=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Required in production: canonical origin, used for Open Graph URLs.
# Do not hard-code the domain anywhere else.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://whereisbrett.com

# ---------------------------------------------------------------------------
# Storage. Create a Vercel Marketplace Upstash Redis (or plain Upstash) store
# and Vercel injects these automatically. With neither pair set, the app falls
# back to a local JSON file at .data/location.json — fine for `next dev` and
# tests, NOT durable on serverless.
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Aliases, if you provisioned Upstash directly rather than through Vercel:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Override the local JSON file path. Local/dev only, with one exception: on
# Railway, mount a volume and point this at it (the Dockerfile defaults to
# /data/location.json) and the file store is durable with no Redis at all.
# LOCAL_STORE_PATH=.data/location.json

# ---------------------------------------------------------------------------
# Optional: keep accepting updates but hide all whereabouts from the public.
# Any of 1/true/yes/on enables it.
# ---------------------------------------------------------------------------
PRIVATE_MODE=false
